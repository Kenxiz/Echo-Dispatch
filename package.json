{
  "name": "echo-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first Discord police dispatcher for ER:LC roleplay servers",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "check": "node scripts/check.js",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@google/genai": "^2.12.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "vitest": "^4.0.15"
  }
}
