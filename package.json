{
  "name": "echo-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first Discord police dispatcher for ER:LC roleplay servers",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "check": "npm run check:syntax && npm run lint && npm run format:check",
    "check:syntax": "node scripts/check.js",
    "lint": "eslint src scripts tests *.js",
    "format": "prettier --write src scripts tests config *.js *.json",
    "format:check": "prettier --check src scripts tests config *.js *.json",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "db:audit": "node scripts/database-maintenance.js audit",
    "db:backup": "node scripts/database-maintenance.js backup",
    "db:restore": "node scripts/database-maintenance.js restore",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@google/genai": "^2.12.0",
    "discord.js": "^14.25.1",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "vitest": "^4.0.15"
  }
}
